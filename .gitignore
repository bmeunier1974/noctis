build/
dist/
wheels/
*.egg-info/
.eggs/
*.egg
MANIFEST

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Coverage & test reports ──────────────────────────────────────────────────
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
junit*.xml

# ── Notebooks ────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

